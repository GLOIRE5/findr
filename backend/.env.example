# Copy this file to .env and change the values if needed.
# Never commit your real .env file.

# Port the API listens on
PORT=3000

# Frontend address allowed to call the API (comma-separated for more than one)
CORS_ORIGIN=http://localhost:5173

# MongoDB connection. Leave it empty to keep items in memory (lost on restart).
# Local MongoDB:   mongodb://localhost:27017/findr
# Docker Compose:  mongodb://db:27017/findr
MONGODB_URI=
